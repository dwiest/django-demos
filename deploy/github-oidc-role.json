{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "GitHub OIDC deployment role for django-demos",
  "Parameters": {
    "CreateGitHubProvider": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Conditions": {
    "CreateProvider": {
      "Fn::Equals": [
        {
          "Ref": "CreateGitHubProvider"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "GitHubProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "CreateProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ]
      }
    },
    "DeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateProvider",
                    {
                      "Ref": "GitHubProvider"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:dwiest/django-demos:environment:ec2-production"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeployDjangoDemos",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": "arn:aws:s3:::dwiest-artifacts/django-demos/*"
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:us-east-1:${AWS::AccountId}:instance/i-0169208b66edd709c"
                    },
                    "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetCommandInvocation",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DeployRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DeployRole",
          "Arn"
        ]
      }
    }
  }
}
